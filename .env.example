# ── Sparring Partner configuration ──────────────────────────────────────────
# Copy to .env (or set in your container environment).

# Path to the SQLite database file. The directory must be writable.
SP_DATABASE_PATH=./data/sparring.db

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SP_SESSION_SECRET=change-me

# ── Provider configuration ──────────────────────────────────────────────────
# At least one provider must be configured unless SP_MOCK_LLM=1.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional live-call speech. The permanent key remains server-side; the browser
# receives a single-use ElevenLabs Scribe token for each microphone connection.
ELEVENLABS_API_KEY=
SP_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
SP_ELEVENLABS_STT_MODEL=scribe_v2_realtime
SP_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
SP_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Default internal prospect voice. ElevenLabs remains optional for microphone input.
SP_PROSPECT_TTS_PROVIDER=kokoro
SP_KOKORO_TTS_BASE_URL=http://127.0.0.1:8880
SP_KOKORO_TTS_MODEL=kokoro
SP_KOKORO_TTS_VOICE=am_adam

# Any OpenAI-compatible endpoint:
SP_OPENAI_COMPATIBLE_BASE_URL=
SP_OPENAI_COMPATIBLE_API_KEY=

# Optional per-role overrides (win over the shared compatible settings):
# SP_PROSPECT_BASE_URL=
# SP_PROSPECT_API_KEY=
# SP_ANALYZER_BASE_URL=
# SP_ANALYZER_API_KEY=
# SP_GRADER_BASE_URL=
# SP_GRADER_API_KEY=

# Optional OpenAI-compatible fallback:
# SP_FALLBACK_MODEL=
# SP_FALLBACK_BASE_URL=
# SP_FALLBACK_API_KEY=

# ── Model selection ──────────────────────────────────────────────────────────
# provider is one of: openai | anthropic | openai-compatible | mock
SP_PROSPECT_PROVIDER=openai
SP_PROSPECT_MODEL=gpt-5.2-mini
SP_ANALYZER_PROVIDER=openai
SP_ANALYZER_MODEL=gpt-5.2-mini
SP_GRADER_PROVIDER=openai
SP_GRADER_MODEL=gpt-5.2

# Deterministic scripted models for demos and tests. No API keys needed.
SP_MOCK_LLM=0

# Local testing only. When set to 1, existing users sign in with email only.
SP_PASSWORDLESS_LOGIN=0
